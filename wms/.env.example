# ============================
# Orquestador WhakaChile
# ============================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://whakachile:whakachile_dev@localhost:5432/whakachile_orquestador?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=tu_jwt_secret_aqui_cambiar_en_produccion
JWT_REFRESH_SECRET=tu_refresh_secret_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ============================
# APIs Externas
# ============================

# BSale
BSALE_API_URL=https://api.bsale.cl/v1
BSALE_ACCESS_TOKEN=tu_token_bsale

# Shopify
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_API_KEY=tu_api_key_shopify
SHOPIFY_API_SECRET=tu_api_secret_shopify
SHOPIFY_ACCESS_TOKEN=tu_access_token_shopify
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=tu_webhook_secret_shopify

# SyncManager
SYNCMANAGER_API_URL=https://api.syncmanager.example.com
SYNCMANAGER_API_KEY=tu_api_key_syncmanager
SYNCMANAGER_WEBHOOK_SECRET=tu_webhook_secret_syncmanager

# ============================
# Configuracion de Resiliencia
# ============================

# Circuit Breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=1000

# Stock Sync (minutos)
STOCK_SYNC_INTERVAL=15
